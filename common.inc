;; Sprite symbols are auto-generated by the asset importer from assets/assets.json

;; ---- Game states ----
STATE_MENU = 0
STATE_LEVEL_SELECT = 1
STATE_GAME = 2
STATE_VICTORY = 3
STATE_SAVE = 4
STATE_TIMEUP = 5

;; ---- Input actions (bit positions) ----
INPUT_UP = 0x01
INPUT_DOWN = 0x02
INPUT_LEFT = 0x04
INPUT_RIGHT = 0x08
INPUT_CAT = 0x10
INPUT_MARK = 0x20
INPUT_HINT = 0x40
INPUT_BACK = 0x80

;; ---- Cell types ----
CELL_EMPTY = 0
CELL_CAT = 1
CELL_MARK = 2

;; ---- Board constants ----
CATDOKU_MAX_N = 9
CATDOKU_MAX_CATS = 9
CATDOKU_MAX_CELLS = 81
CATDOKU_NUM_LEVELS = 200
CATDOKU_DIFFICULTIES = 5
CATDOKU_LEVELS_PER_DIFF = 40      ; CATDOKU_NUM_LEVELS / CATDOKU_DIFFICULTIES
CATDOKU_DECOMP_BUFFER_SIZE = 128

;; ---- Screen dimensions ----
CATDOKU_CELL_SIZE = 8
CATDOKU_BOARD_OFFSET_X = 30   ; bytes (sprite X is a byte coordinate)
CATDOKU_BOARD_OFFSET_Y = 80

;; ---- Cursor: yellow frame one pixel outside the cell ----
CURSOR_PEN = 6               ; yellow (HW 0x0A) in _orig_palette
CURSOR_BYTE = 0x3C           ; pen 6 in both Mode 0 pixels
;; Region r is drawn with pen r+1, skipping CURSOR_PEN so no region shares the cursor colour.

;; ---- Text colours: fwk_text_set_color indices (framework/src/ui/text.s table) ----
TEXT_WHITE = 0                    ; pen 15
TEXT_YELLOW = 1                   ; pen 6
TEXT_GREEN = 8                    ; pen 8
TEXT_BLUE = 9                     ; pen 12, bright blue (screen titles)

;; ---- Audio SFX ids ----
SFX_CAT = 0
SFX_MARK = 1
SFX_ERROR = 2
SFX_VICTORY = 3
SFX_NAV = 4

;; ---- Palette (fixed, 16 hardware colours) ----
;; Defined in main.s to avoid multiple definitions

;; ---- Debug check macro ----
CATDOKU_DEBUG_CHECKS = 0
.macro CATDOKU_CHECK_OK
.if CATDOKU_DEBUG_CHECKS
    jp c, _catdoku_fail
.endif
.endm